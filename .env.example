# Copy to .env and fill in. .env is gitignored: never commit real keys.
# Only EXPO_PUBLIC_* values are built into the app. Anything else stays on your computer/server.

# --- Option A: API-Football (real fixtures, predictions, odds, lineups, stats) ---
# Server side only: the dev proxy (npm run proxy) reads this. Never prefix it with EXPO_PUBLIC_.
APIFOOTBALL_KEY=your-api-football-key
# Where the app finds the proxy:
#   phone with Expo Go: http://<your computer's LAN IP>:8787 (npm run proxy prints it)
#   web on this computer: http://localhost:8787
#   release: https://<project-ref>.supabase.co/functions/v1/football
EXPO_PUBLIC_FOOTBALL_PROXY_URL=
# Supabase anon (public) key, only when the proxy is the Supabase Edge Function. Safe to ship.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# League ids in display order, or "all" (every league API-Football covers; needs a paid plan to be useful).
# Default: NPFL, CAF CL, CAF Confed Cup, Premier League, Championship, LaLiga, Serie A, Bundesliga, Ligue 1,
# Eredivisie, Primeira Liga, Champions League, Europa League, Conference League.
EXPO_PUBLIC_FOOTBALL_LEAGUES=399,12,20,39,40,140,135,78,61,88,94,2,3,848
# Days either side of today. The free plan only allows 1 (yesterday, today, tomorrow).
EXPO_PUBLIC_FOOTBALL_DAY_RANGE=1
# Predictions loaded in the background per app start (1 request each, cached 12 h).
EXPO_PUBLIC_FOOTBALL_PREFETCH_PREDICTIONS=20

# --- Option B: your own backend returning the shapes in src/types (see src/services/httpApi.ts) ---
EXPO_PUBLIC_API_URL=

# Leave both empty to use the built-in sample data.
